{
  "name": "todolist-express-mvc",
  "version": "1.0.0",
  "description": "Todolist API in Express with MVC architecture (add, list, complete, delete tasks)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:pg": "cross-env POSTGRES_URL='postgres://postgres:pass@localhost:5432/postgres' nodemon server.js",
    "dev:mongo": "cross-env MONGODB_URI='mongodb://localhost:27017/todolist' nodemon server.js",
    "test": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "mongoose": "^8.19.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.37.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  }
}
